# Copy this file to .env and replace every change-me value.
COMPOSE_PROJECT_NAME=myfinance

POSTGRES_DB=myfinance
POSTGRES_USER=myfinance
POSTGRES_PASSWORD=change-me
# Compose uses this internal hostname. Do not point it at localhost in Docker.
DATABASE_URL=postgresql+psycopg://myfinance:change-me@db:5432/myfinance

MAX_USERS=5
MIN_PASSWORD_LENGTH=10
JWT_SECRET=change-me-use-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated origins or a JSON list.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1
