# Optional Compose project name used to namespace containers and volumes.
COMPOSE_PROJECT_NAME=myfinance

# Local PostgreSQL database and non-sensitive development account defaults.
POSTGRES_DB=myfinance
POSTGRES_USER=myfinance
# Placeholder only; replace it in an untracked .env before using non-local data.
POSTGRES_PASSWORD=change-me-for-local-development
# Port published only on localhost.
POSTGRES_PORT=5432

# Port published only on localhost for the FastAPI service.
BACKEND_PORT=8000
# JSON array of browser origins accepted by the API.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Backend logging threshold: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Port published only on localhost for the nginx frontend.
FRONTEND_PORT=3000
