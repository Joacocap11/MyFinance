{
  "expo": {
    "name": "MyFinance",
    "slug": "myfinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myfinance",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.myfinance.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1b35"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fcaccde-3221-45c9-acd8-9d3ea4d0a0d3"
      }
    }
  }
}
